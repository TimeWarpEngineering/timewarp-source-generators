<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Roslyn">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Code Analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Build Tasks">
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="Dev CLI">
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.12" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.12" />
    <PackageVersion Include="TimeWarp.Amuru" Version="3.0.0-beta.2" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="3.0.0-beta.2" />
    <PackageVersion Include="TimeWarp.Terminal" Version="2.0.0-beta.1" />
  </ItemGroup>
</Project>
