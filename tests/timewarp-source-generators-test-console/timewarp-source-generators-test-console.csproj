<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TimeWarp.SourceGenerators.TestConsole</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <!-- Configure MSBuild to show detailed output including Info messages -->
    <MSBuildLoggerVerbosity>diagnostic</MSBuildLoggerVerbosity>
    <!-- Smoke-test console intentionally uses System.Console; repo BannedSymbols target production CLIs -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- ProjectReference as Analyzer so CI/local tests exercise in-tree generators -->
    <ProjectReference Include="..\..\source\timewarp-source-generators\timewarp-source-generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include markdown files as AdditionalFiles -->
    <AdditionalFiles Include="**/*.md" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Persist generator output under obj/ (audit-pruned; not committed) -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid double-compile if anything still lands under the output path -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" Condition="'$(CompilerGeneratedFilesOutputPath)' != ''" />
  </ItemGroup>

</Project>
